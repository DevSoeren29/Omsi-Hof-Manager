<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OmsiHofManager</RootNamespace>
    <AssemblyName>OmsiHofManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Product>OMSI Hof Manager</Product>
    <Description>Hofdateien für OMSI 2 sammeln und auf Busse verteilen</Description>
    <Version>1.0.0</Version>
    <Copyright>MIT License</Copyright>

    <!-- Fluent-Theme (ThemeMode) ist in .NET 9 noch als "experimentell" markiert -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
