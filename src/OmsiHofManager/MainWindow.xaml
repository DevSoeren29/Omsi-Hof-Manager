<Window x:Class="OmsiHofManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:OmsiHofManager.Models"
        xmlns:vm="clr-namespace:OmsiHofManager.ViewModels"
        Title="OMSI Hof Manager"
        Icon="Assets/app.ico"
        Width="1240" Height="780" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding DistributeCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RescanCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddHofsCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportFromGameCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style x:Key="SearchPlaceholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="36,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Eintrag der Hof-Bibliothek -->
        <DataTemplate DataType="{x:Type m:HofFile}">
            <Grid Margin="0,4" Background="Transparent" ToolTip="{Binding FullPath}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Im Explorer anzeigen" Click="ShowHof_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="6" Margin="0,0,12,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="16" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Eintrag der Busliste -->
        <DataTemplate DataType="{x:Type m:BusFolder}">
            <Grid Margin="0,4" Background="Transparent" ToolTip="{Binding ModelsToolTip}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Busordner im Explorer öffnen" Click="OpenBusFolder_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="34" Height="34" CornerRadius="6" Margin="0,0,12,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE806;" FontSize="16" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="3" CornerRadius="10" Padding="8,2" Margin="8,0,4,0" VerticalAlignment="Center"
                        Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMissing}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MissingText}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="ItemList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfbereich -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="10" Margin="0,0,14,0"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE806;" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="OMSI Hof Manager" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="13"
                           Text="Hofdateien sammeln und mit einem Tastendruck auf deine Busse verteilen" />
            </StackPanel>
        </Grid>

        <!-- OMSI-Pfad -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,10,0" FontSize="18" />
                    <TextBlock Text="Vehicles-Ordner" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center"
                         Text="{Binding VehiclesPath, Mode=OneWay, TargetNullValue='Nicht ausgewählt'}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding AutoDetectCommand}" ToolTip="OMSI 2 über Steam automatisch finden">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                            <TextBlock Text="Automatisch finden" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding BrowseVehiclesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                            <TextBlock Text="Durchsuchen…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Margin="0" Command="{Binding RescanCommand}" ToolTip="Busse neu einlesen (Strg+R)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                            <TextBlock Text="Neu einlesen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hauptbereich -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Hof-Bibliothek -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="0"
                                Command="{Binding OpenLibraryFolderCommand}" ToolTip="{Binding LibraryFolder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                                <TextBlock Text="Ordner" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Hof-Bibliothek" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding HofHeader}" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Style="{StaticResource ToolButton}" Command="{Binding AddHofsCommand}" ToolTip="Hofdateien hinzufügen (Strg+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                <TextBlock Text="Hinzufügen" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding AddHofFolderCommand}" ToolTip="Alle .hof-Dateien aus einem Ordner (inkl. Unterordner) hinzufügen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" Margin="0,0,8,0" />
                                <TextBlock Text="Ordner…" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding ImportFromGameCommand}" ToolTip="Alle Hofdateien aus den OMSI-Bussen in die Bibliothek übernehmen (Strg+I)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                <TextBlock Text="Aus OMSI importieren" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding RemoveHofsCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=HofList}"
                                ToolTip="Markierte Einträge aus der Bibliothek entfernen (Entf)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                                <TextBlock Text="Entfernen" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HofSearch" Padding="36,6,10,6"
                                 Text="{Binding HofFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="12,0,0,0" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Hofdateien durchsuchen…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SearchPlaceholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=HofSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource ToolButton}" Content="Alle" Command="{Binding SelectAllHofsCommand}" />
                            <Button Style="{StaticResource ToolButton}" Margin="0" Content="Keine" Command="{Binding SelectNoHofsCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <ListBox x:Name="HofList" Style="{StaticResource ItemList}" ItemsSource="{Binding HofsView}"
                                 KeyDown="HofList_KeyDown" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="24">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hofs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Noch keine Hofdateien" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                                       Text=".hof-Dateien oder Ordner einfach hierher ziehen – oder „Aus OMSI importieren“ wählen." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Busse -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Busse" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding BusHeader}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BusSearch" Padding="36,6,10,6"
                                 Text="{Binding BusFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="12,0,0,0" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Busse durchsuchen…">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SearchPlaceholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=BusSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource ToolButton}" Content="Alle" Command="{Binding SelectAllBusesCommand}" />
                            <Button Style="{StaticResource ToolButton}" Content="Keine" Command="{Binding SelectNoBusesCommand}" />
                            <Button Style="{StaticResource ToolButton}" Margin="0" Content="Unvollständige" Command="{Binding SelectMissingBusesCommand}"
                                    ToolTip="Nur Busse auswählen, denen ausgewählte Hofdateien fehlen" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox Style="{StaticResource ItemList}" ItemsSource="{Binding BusesView}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="24">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Buses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE806;" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Keine Busse gefunden" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                                       Text="Wähle oben den OMSI-2- bzw. Vehicles-Ordner aus." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Statusleiste (InfoBar) -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="6" BorderThickness="1" Padding="14,10"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:StatusSeverity.Success}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:StatusSeverity.Warning}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:StatusSeverity.Error}">
                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="16" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:StatusSeverity.Success}">
                                    <Setter Property="Text" Value="&#xE930;" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:StatusSeverity.Warning}">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:StatusSeverity.Error}">
                                    <Setter Property="Text" Value="&#xEA39;" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Padding="6" Margin="12,-4,-6,-4" Background="Transparent" BorderThickness="0"
                        Command="{Binding DismissStatusCommand}" ToolTip="Schließen">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- Aktionsleiste -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <CheckBox Content="Vorhandene Hofdateien überschreiben" IsChecked="{Binding OverwriteExisting}" />
                    <CheckBox Content="Vorher Sicherung der überschriebenen Dateien anlegen" Margin="0,4,0,0"
                              IsChecked="{Binding BackupBeforeOverwrite}" IsEnabled="{Binding OverwriteExisting}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0">
                    <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <ProgressBar Width="240" Margin="0,8,0,0" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Padding="14,9" Margin="0,0,8,0" Command="{Binding RemoveFromBusesCommand}"
                            ToolTip="Ausgewählte Hofdateien aus den ausgewählten Bussen entfernen (Papierkorb)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                            <TextBlock Text="Aus Bussen entfernen" />
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource AccentButtonStyle}" Padding="22,9" Command="{Binding DistributeCommand}"
                            ToolTip="Ausgewählte Hofdateien auf die ausgewählten Busse verteilen (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,10,0" />
                            <TextBlock Text="Verteilen" FontWeight="SemiBold" />
                            <TextBlock Text="F5" Margin="10,0,0,0" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
